#if defined(_WIN32)
#  define SEP '\\'
#else
#  define SEP '/'
#endif

/* Filled in by CMake from GNUInstallDirs: how the install tree is laid out,
 * relative to where the executable sits (build tree mirrors it). */
static const char bin_to_root[] = "@PK_APP_BIN_TO_ROOT@";   /* bin dir -> root */
static const char data_dir[]    = "@PK_APP_DATADIR@";       /* root -> shared data */
static const char dir_name[]    = "@PK_APP_NAME@";          /* per-user folder name */

static @PK_APP_C_PREFIX@_paths g_paths;
static int  g_ok;
static char g_error[512];

/* errors ------------------------------------------------------------------ */

/* Keeps the first error; later ones are usually knock-on failures. */
static void set_error(const char* fmt, ...) {
    va_list ap;
    if (g_error[0] != '\0') {
        return;
    }
    va_start(ap, fmt);
    vsnprintf(g_error, sizeof g_error, fmt, ap);
    va_end(ap);
}

static void out_of_memory(void) {
    set_error("out of memory");
}

static void os_error(const char* what, const char* path, unsigned long code) {
    char msg[256] = "";
#if defined(_WIN32)
    wchar_t wmsg[256];
    DWORD n = FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
                             NULL, (DWORD)code, 0, wmsg, 256, NULL);
    while (n > 0 && (wmsg[n - 1] == L'\r' || wmsg[n - 1] == L'\n' ||
                     wmsg[n - 1] == L' ' || wmsg[n - 1] == L'.')) {
        wmsg[--n] = L'\0';
    }
    if (n == 0 || WideCharToMultiByte(CP_UTF8, 0, wmsg, -1, msg, (int)sizeof msg,
                                      NULL, NULL) == 0) {
        snprintf(msg, sizeof msg, "error 0x%08lX", code);
    }
#else
    snprintf(msg, sizeof msg, "%s", strerror((int)code));
#endif
    if (path != NULL) {
        set_error("%s %s: %s", what, path, msg);
    } else {
        set_error("%s: %s", what, msg);
    }
}

/* strings and paths ------------------------------------------------------- */

static char* dup_str(const char* s) {
    const size_t n = strlen(s) + 1;
    char* r = (char*)malloc(n);
    if (r == NULL) {
        out_of_memory();
        return NULL;
    }
    memcpy(r, s, n);
    return r;
}

static int is_sep(char c) {
#if defined(_WIN32)
    return c == '\\' || c == '/';
#else
    return c == '/';
#endif
}

/* Length of the part never stripped: "/", "C:\", "\\server\share\". */
static size_t root_len(const char* p) {
#if defined(_WIN32)
    const char lower = (char)(p[0] | 0x20);
    if (lower >= 'a' && lower <= 'z' && p[1] == ':') {
        return is_sep(p[2]) ? 3 : 2;
    }
    if (is_sep(p[0]) && is_sep(p[1])) {
        size_t i = 2;
        int seps = 0;
        for (; p[i] != '\0'; ++i) {
            if (is_sep(p[i]) && ++seps == 2) {
                return i + 1;
            }
        }
        return i;
    }
#endif
    return is_sep(p[0]) ? 1 : 0;
}

static void trim_trailing_seps(char* p) {
    const size_t root = root_len(p);
    size_t n = strlen(p);
    while (n > root && is_sep(p[n - 1])) {
        p[--n] = '\0';
    }
}

/* a / b with native separators. NULL in, NULL out, so calls can chain. */
static char* join(const char* a, const char* b) {
    size_t na, nb, i = 0, k;
    int need_sep;
    char* r;
    if (a == NULL || b == NULL) {
        return NULL;
    }
    if (root_len(b) > 0) {
        return dup_str(b);
    }
    na = strlen(a);
    nb = strlen(b);
    need_sep = na > 0 && nb > 0 && !is_sep(a[na - 1]);
    r = (char*)malloc(na + (size_t)need_sep + nb + 1);
    if (r == NULL) {
        out_of_memory();
        return NULL;
    }
    memcpy(r, a, na);
    i = na;
    if (need_sep) {
        r[i++] = SEP;
    }
    for (k = 0; k < nb; ++k) {
        r[i++] = is_sep(b[k]) ? SEP : b[k];
    }
    r[i] = '\0';
    return r;
}

static char* join3(const char* a, const char* b, const char* c) {
    char* t = join(a, b);
    char* r = join(t, c);
    free(t);
    return r;
}

static char* parent_dir(const char* path) {
    char* r = dup_str(path);
    size_t root, n;
    if (r == NULL) {
        return NULL;
    }
    root = root_len(r);
    n = strlen(r);
    while (n > root && is_sep(r[n - 1])) --n;
    while (n > root && !is_sep(r[n - 1])) --n;
    while (n > root && is_sep(r[n - 1])) --n;
    r[n] = '\0';
    return r;
}

/* platform ---------------------------------------------------------------- */

#if defined(_WIN32)

#define EXISTS_CODE ERROR_ALREADY_EXISTS

static char* narrow(const wchar_t* w) {
    char* r;
    const int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, NULL, 0, NULL, NULL);
    if (n <= 0) {
        os_error("WideCharToMultiByte failed", NULL, GetLastError());
        return NULL;
    }
    r = (char*)malloc((size_t)n);
    if (r == NULL) {
        out_of_memory();
        return NULL;
    }
    WideCharToMultiByte(CP_UTF8, 0, w, -1, r, n, NULL, NULL);
    return r;
}

static wchar_t* widen(const char* s) {
    wchar_t* r;
    const int n = MultiByteToWideChar(CP_UTF8, 0, s, -1, NULL, 0);
    if (n <= 0) {
        os_error("MultiByteToWideChar failed", NULL, GetLastError());
        return NULL;
    }
    r = (wchar_t*)malloc((size_t)n * sizeof *r);
    if (r == NULL) {
        out_of_memory();
        return NULL;
    }
    MultiByteToWideChar(CP_UTF8, 0, s, -1, r, n);
    return r;
}

static char* full_path_w(const wchar_t* in) {
    DWORD n = GetFullPathNameW(in, 0, NULL, NULL);
    for (;;) {
        wchar_t* buf;
        DWORD got;
        if (n == 0) {
            os_error("GetFullPathNameW failed", NULL, GetLastError());
            return NULL;
        }
        buf = (wchar_t*)malloc((size_t)n * sizeof *buf);
        if (buf == NULL) {
            out_of_memory();
            return NULL;
        }
        got = GetFullPathNameW(in, n, buf, NULL);
        if (got > 0 && got < n) {
            char* r = narrow(buf);
            free(buf);
            if (r != NULL) {
                trim_trailing_seps(r);
            }
            return r;
        }
        free(buf);
        n = got;
    }
}

static char* full_path(const char* in) {
    wchar_t* w = widen(in);
    char* r = (w != NULL) ? full_path_w(w) : NULL;
    free(w);
    return r;
}

static char* executable_path(void) {
    DWORD cap = MAX_PATH;
    for (;;) {
        DWORD n;
        wchar_t* buf = (wchar_t*)malloc((size_t)cap * sizeof *buf);
        if (buf == NULL) {
            out_of_memory();
            return NULL;
        }
        n = GetModuleFileNameW(NULL, buf, cap);
        if (n == 0) {
            const DWORD e = GetLastError();
            free(buf);
            os_error("GetModuleFileNameW failed", NULL, e);
            return NULL;
        }
        if (n < cap) {   /* n == cap means the path was cut off */
            char* r = full_path_w(buf);
            free(buf);
            return r;
        }
        free(buf);
        cap *= 2;
    }
}

static char* current_dir(void) {
    DWORD n = GetCurrentDirectoryW(0, NULL);
    for (;;) {
        wchar_t* buf;
        DWORD got;
        if (n == 0) {
            os_error("GetCurrentDirectoryW failed", NULL, GetLastError());
            return NULL;
        }
        buf = (wchar_t*)malloc((size_t)n * sizeof *buf);
        if (buf == NULL) {
            out_of_memory();
            return NULL;
        }
        got = GetCurrentDirectoryW(n, buf);
        if (got > 0 && got < n) {
            char* r = narrow(buf);
            free(buf);
            return r;
        }
        free(buf);
        n = got;
    }
}

/* Known folders keep non-ASCII user names intact, unlike getenv(). */
static char* known_folder(REFKNOWNFOLDERID id, const char* label) {
    PWSTR raw = NULL;
    char* r = NULL;
    const HRESULT hr = SHGetKnownFolderPath(id, KF_FLAG_CREATE, NULL, &raw);
    if (SUCCEEDED(hr) && raw != NULL) {
        r = narrow(raw);
    } else {
        os_error("SHGetKnownFolderPath failed for", label, (unsigned long)hr);
    }
    CoTaskMemFree(raw);
    return r;
}

static int is_dir(const char* p) {
    wchar_t* w = widen(p);
    const DWORD a = (w != NULL) ? GetFileAttributesW(w) : INVALID_FILE_ATTRIBUTES;
    free(w);
    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY) != 0;
}

static unsigned long mkdir_one(const char* p) {
    wchar_t* w = widen(p);
    DWORD e;
    if (w == NULL) {
        return ERROR_NOT_ENOUGH_MEMORY;
    }
    e = CreateDirectoryW(w, NULL) ? 0 : GetLastError();
    free(w);
    return e;
}

static char* temp_dir(void) {
    wchar_t buf[MAX_PATH + 1];
    char* r;
    const DWORD n = GetTempPathW(MAX_PATH + 1, buf);
    if (n == 0 || n > MAX_PATH) {
        os_error("GetTempPathW failed", NULL, n == 0 ? GetLastError() : ERROR_INSUFFICIENT_BUFFER);
        return NULL;
    }
    r = narrow(buf);
    if (r == NULL) {
        return NULL;
    }
    trim_trailing_seps(r);
    if (!is_dir(r)) {
        os_error("temporary folder", r, ERROR_PATH_NOT_FOUND);
        free(r);
        return NULL;
    }
    return r;
}

#else

#define EXISTS_CODE EEXIST

static char* real_path(const char* in) {
    char* r = realpath(in, NULL);
    if (r == NULL) {
        os_error("cannot resolve", in, (unsigned long)errno);
    }
    return r;
}

static char* executable_path(void) {
#  if defined(__APPLE__)
    uint32_t size = 0;
    char* buf;
    char* r;
    _NSGetExecutablePath(NULL, &size);
    buf = (char*)malloc(size);
    if (buf == NULL) {
        out_of_memory();
        return NULL;
    }
    if (_NSGetExecutablePath(buf, &size) != 0) {
        free(buf);
        os_error("_NSGetExecutablePath failed", NULL, ENAMETOOLONG);
        return NULL;
    }
    r = real_path(buf);
    free(buf);
    return r;
#  else
    return real_path("/proc/self/exe");
#  endif
}

static char* current_dir(void) {
    size_t cap = 256;
    for (;;) {
        char* buf = (char*)malloc(cap);
        if (buf == NULL) {
            out_of_memory();
            return NULL;
        }
        if (getcwd(buf, cap) != NULL) {
            return buf;
        }
        free(buf);
        if (errno != ERANGE) {
            os_error("getcwd failed", NULL, (unsigned long)errno);
            return NULL;
        }
        cap *= 2;
    }
}

static char* home_dir(void) {
    const char* h = getenv("HOME");
    const struct passwd* pw;
    char* r;
    if (h != NULL && h[0] == '/') {
        r = dup_str(h);
    } else if ((pw = getpwuid(getuid())) != NULL && pw->pw_dir != NULL && pw->pw_dir[0] == '/') {
        r = dup_str(pw->pw_dir);   /* no usable $HOME (services, some CI) */
    } else {
        os_error("cannot find the home folder", NULL, ENOENT);
        return NULL;
    }
    if (r != NULL) {
        trim_trailing_seps(r);
    }
    return r;
}

#  if !defined(__APPLE__)
/* XDG says to ignore a variable that is unset, empty or relative. */
static char* xdg_dir(const char* var, const char* home, const char* fallback) {
    const char* v = getenv(var);
    char* r;
    if (v == NULL || v[0] != '/') {
        return join(home, fallback);
    }
    r = dup_str(v);
    if (r != NULL) {
        trim_trailing_seps(r);
    }
    return r;
}
#  endif

static int is_dir(const char* p) {
    struct stat st;
    return stat(p, &st) == 0 && S_ISDIR(st.st_mode);
}

static unsigned long mkdir_one(const char* p) {
    return mkdir(p, 0777) == 0 ? 0 : (unsigned long)errno;
}

/* Same variables, same order, as std::filesystem::temp_directory_path(). */
static char* temp_dir(void) {
    static const char* const vars[] = {"TMPDIR", "TMP", "TEMP", "TEMPDIR"};
    const char* t = NULL;
    char* r;
    size_t i;
    for (i = 0; i < sizeof vars / sizeof vars[0] && t == NULL; ++i) {
        t = getenv(vars[i]);
        if (t != NULL && t[0] == '\0') {
            t = NULL;
        }
    }
    if (t == NULL) {
        t = "/tmp";
    }
    r = (t[0] == '/') ? dup_str(t) : real_path(t);
    if (r == NULL) {
        return NULL;
    }
    trim_trailing_seps(r);
    if (!is_dir(r)) {
        os_error("temporary folder", r, ENOTDIR);
        free(r);
        return NULL;
    }
    return r;
}

#endif

/* resolution -------------------------------------------------------------- */

/* mkdir -p; errors on the way down are ignored, the final check decides. */
static int make_dirs(const char* path) {
    char* p;
    size_t i;
    unsigned long e;
    if (path == NULL) {
        return 0;
    }
    p = dup_str(path);
    if (p == NULL) {
        return 0;
    }
    for (i = root_len(p); p[i] != '\0'; ++i) {
        if (i > 0 && is_sep(p[i]) && !is_sep(p[i - 1])) {
            const char c = p[i];
            p[i] = '\0';
            (void)mkdir_one(p);
            p[i] = c;
        }
    }
    e = mkdir_one(p);
    if (e != 0 && !(e == EXISTS_CODE && is_dir(p))) {
        os_error("cannot create folder", path, e);
        free(p);
        return 0;
    }
    free(p);
    return 1;
}

static char* install_root(const char* bin_dir) {
    char* joined;
    char* r;
    if (bin_to_root[0] == '\0') {
        return dup_str(bin_dir);
    }
    joined = join(bin_dir, bin_to_root);
    if (joined == NULL) {
        return NULL;
    }
#if defined(_WIN32)
    r = full_path(joined);
#else
    r = real_path(joined);
#endif
    free(joined);
    return r;
}

static int resolve(@PK_APP_C_PREFIX@_paths* p) {
    const char* dirs[4];
    size_t i;
    char* t;

    if ((p->startup_cwd = current_dir()) == NULL) return 0;
    if ((p->executable = executable_path()) == NULL) return 0;
    if ((p->bin_dir = parent_dir(p->executable)) == NULL) return 0;
    if ((p->root = install_root(p->bin_dir)) == NULL) return 0;
    if ((p->resources = join3(p->root, data_dir, dir_name)) == NULL) return 0;
    if ((p->temp = temp_dir()) == NULL) return 0;

#if defined(_WIN32)
    if ((p->home = known_folder(&FOLDERID_Profile, "Profile")) == NULL) return 0;
    if ((t = known_folder(&FOLDERID_RoamingAppData, "RoamingAppData")) == NULL) return 0;
    p->config = join(t, dir_name);
    free(t);
    if ((t = known_folder(&FOLDERID_LocalAppData, "LocalAppData")) == NULL) return 0;
    p->data = join(t, dir_name);
    free(t);
    p->cache = join(p->data, "cache");
    p->logs  = join(p->data, "logs");
#elif defined(__APPLE__)
    (void)t;
    if ((p->home = home_dir()) == NULL) return 0;
    p->config = join3(p->home, "Library/Application Support", dir_name);
    p->data   = p->config;
    p->cache  = join3(p->home, "Library/Caches", dir_name);
    p->logs   = join3(p->home, "Library/Logs", dir_name);
#else
    if ((p->home = home_dir()) == NULL) return 0;
    t = xdg_dir("XDG_CONFIG_HOME", p->home, ".config");
    p->config = join(t, dir_name);
    free(t);
    t = xdg_dir("XDG_DATA_HOME", p->home, ".local/share");
    p->data = join(t, dir_name);
    free(t);
    t = xdg_dir("XDG_CACHE_HOME", p->home, ".cache");
    p->cache = join(t, dir_name);
    free(t);
    t = xdg_dir("XDG_STATE_HOME", p->home, ".local/state");
    p->logs = join3(t, dir_name, "logs");
    free(t);
#endif

    dirs[0] = p->config;
    dirs[1] = p->data;
    dirs[2] = p->cache;
    dirs[3] = p->logs;
    for (i = 0; i < 4; ++i) {
        if (!make_dirs(dirs[i])) return 0;
    }
    return 1;
}

/* public API -------------------------------------------------------------- */

#if defined(_WIN32)
static INIT_ONCE g_once = INIT_ONCE_STATIC_INIT;

static BOOL CALLBACK run_resolve(PINIT_ONCE once, PVOID param, PVOID* context) {
    (void)once;
    (void)param;
    (void)context;
    g_ok = resolve(&g_paths);
    return TRUE;
}

static void ensure_resolved(void) {
    InitOnceExecuteOnce(&g_once, run_resolve, NULL, NULL);
}
#else
static pthread_once_t g_once = PTHREAD_ONCE_INIT;

static void run_resolve(void) {
    g_ok = resolve(&g_paths);
}

static void ensure_resolved(void) {
    pthread_once(&g_once, run_resolve);
}
#endif

const @PK_APP_C_PREFIX@_paths* @PK_APP_C_PREFIX@_app_paths(void) {
    ensure_resolved();
    return g_ok ? &g_paths : NULL;
}

const char* @PK_APP_C_PREFIX@_app_paths_error(void) {
    ensure_resolved();
    return g_ok ? NULL : g_error;
}
