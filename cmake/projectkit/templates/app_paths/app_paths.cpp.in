namespace fs = std::filesystem;

namespace @PK_APP_NAMESPACE@ {
namespace {

/* Filled in by CMake from GNUInstallDirs: how the install tree is laid out,
 * relative to where the executable sits (build tree mirrors it). */
constexpr const char* bin_to_root = "@PK_APP_BIN_TO_ROOT@";   /* bin dir -> root */
constexpr const char* data_dir    = "@PK_APP_DATADIR@";       /* root -> shared data */
constexpr const char* dir_name    = "@PK_APP_NAME@";          /* per-user folder name */

fs::path executable_path() {
#if defined(_WIN32)
    std::wstring buf(MAX_PATH, L'\0');
    for (;;) {
        const DWORD n = GetModuleFileNameW(nullptr, buf.data(),
                                           static_cast<DWORD>(buf.size()));
        if (n == 0) {
            throw std::system_error(static_cast<int>(GetLastError()),
                                    std::system_category(), "GetModuleFileNameW");
        }
        if (n < buf.size()) {   /* n == buf.size() means the path was cut off */
            buf.resize(n);
            return fs::weakly_canonical(fs::path{buf});
        }
        buf.resize(buf.size() * 2);
    }
#elif defined(__APPLE__)
    std::uint32_t size = 0;
    _NSGetExecutablePath(nullptr, &size);
    std::string buf(size, '\0');
    if (_NSGetExecutablePath(buf.data(), &size) != 0) {
        throw std::system_error(std::make_error_code(std::errc::filename_too_long),
                                "_NSGetExecutablePath");
    }
    return fs::canonical(buf.c_str());
#else
    return fs::canonical("/proc/self/exe");
#endif
}

#if defined(_WIN32)
/* Known folders keep non-ASCII user names intact, unlike getenv(). */
fs::path known_folder(REFKNOWNFOLDERID id) {
    PWSTR raw = nullptr;
    const HRESULT hr = SHGetKnownFolderPath(id, KF_FLAG_CREATE, nullptr, &raw);
    fs::path result = (hr >= 0 && raw != nullptr) ? fs::path{raw} : fs::path{};
    CoTaskMemFree(raw);
    if (hr < 0) {
        throw std::system_error(static_cast<int>(hr), std::system_category(),
                                "SHGetKnownFolderPath");
    }
    return result;
}
#else
fs::path env_path(const char* name) {
    const char* value = std::getenv(name);
    return (value != nullptr && *value != '\0') ? fs::path{value} : fs::path{};
}

#  if !defined(__APPLE__)
/* XDG says to ignore a variable that is unset, empty or relative. */
fs::path env_or(const char* name, const fs::path& fallback) {
    fs::path p = env_path(name);
    return p.is_absolute() ? p : fallback;
}
#  endif

fs::path home_dir() {
    fs::path home = env_path("HOME");
    if (home.is_absolute()) {
        return home;
    }
    /* No usable $HOME (services, some CI): ask the user database. */
    if (const passwd* pw = getpwuid(getuid()); pw != nullptr && pw->pw_dir != nullptr) {
        return fs::path{pw->pw_dir};
    }
    throw std::system_error(std::make_error_code(std::errc::no_such_file_or_directory),
                            "no home directory");
}
#endif

AppPaths resolve() {
    AppPaths p;

    p.startup_cwd = fs::current_path();
    p.executable  = executable_path();
    p.bin_dir     = p.executable.parent_path();
    p.root        = (p.bin_dir / bin_to_root).lexically_normal();
    if (!p.root.has_filename() && p.root.has_relative_path()) {
        p.root = p.root.parent_path();   /* "a/bin/.." normalizes to "a/" */
    }
    p.resources = p.root / data_dir / dir_name;
    p.temp      = fs::temp_directory_path();

#if defined(_WIN32)
    p.home   = known_folder(FOLDERID_Profile);
    p.config = known_folder(FOLDERID_RoamingAppData) / dir_name;
    p.data   = known_folder(FOLDERID_LocalAppData) / dir_name;
    p.cache  = p.data / "cache";
    p.logs   = p.data / "logs";
#elif defined(__APPLE__)
    p.home = home_dir();
    const fs::path library = p.home / "Library";
    p.config = library / "Application Support" / dir_name;
    p.data   = p.config;
    p.cache  = library / "Caches" / dir_name;
    p.logs   = library / "Logs" / dir_name;
#else
    p.home   = home_dir();
    p.config = env_or("XDG_CONFIG_HOME", p.home / ".config") / dir_name;
    p.data   = env_or("XDG_DATA_HOME", p.home / ".local" / "share") / dir_name;
    p.cache  = env_or("XDG_CACHE_HOME", p.home / ".cache") / dir_name;
    p.logs   = env_or("XDG_STATE_HOME", p.home / ".local" / "state") / dir_name / "logs";
#endif

    for (const fs::path* dir : {&p.config, &p.data, &p.cache, &p.logs}) {
        fs::create_directories(*dir);
    }
    return p;
}

} /* namespace */

const AppPaths& app_paths() {
    /* Built once on the first call, thread-safe; never runs if unused. */
    static const AppPaths paths = resolve();
    return paths;
}

} /* namespace @PK_APP_NAMESPACE@ */
