# QCDX package repository. template/ has its own .gitignore, the one every new
# project starts with.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build output (python -m build, the zipapp, CMake checks)
build/
stage/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Written by the release workflow (the commit a build came from)
src/qcdx/_commit.py

# conan create (test_package)
CMakeUserPresets.json
