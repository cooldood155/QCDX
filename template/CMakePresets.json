{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": { "type": "BOOL", "value": "ON" }
      }
    },

    {
      "name": "cross-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "qcdxHostTools_DIR": { "type": "PATH", "value": "${sourceDir}/build/host-tools" }
      }
    },

    {
      "name": "debug-base",
      "hidden": true,
      "toolchainFile": "${sourceDir}/build/Debug/generators/conan_toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release-base",
      "hidden": true,
      "toolchainFile": "${sourceDir}/build/Release/generators/conan_toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "relwithdebinfo-base",
      "hidden": true,
      "toolchainFile": "${sourceDir}/build/RelWithDebInfo/generators/conan_toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "minsizerel-base",
      "hidden": true,
      "toolchainFile": "${sourceDir}/build/MinSizeRel/generators/conan_toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    },

    {
      "name": "host-tools",
      "displayName": "Build host tools only, in Release mode",
      "inherits": ["base", "release-base"],
      "cacheVariables": {
        "QCDX_BUILD_APPS": "OFF",
        "QCDX_BUILD_TESTS": "OFF",
        "QCDX_LIBRARY_TYPE": "NONE",
        "QCDX_SA_ALL": "OFF"
      }
    },

    {
      "name": "native-debug",
      "displayName": "Native / Debug",
      "description": "Requires: conan install . -pr:a profiles/native -s build_type=Debug --build=missing",
      "inherits": ["base", "debug-base"]
    },
    {
      "name": "native-release",
      "displayName": "Native / Release",
      "description": "Requires: conan install . -pr:a profiles/native -s build_type=Release --build=missing",
      "inherits": ["base", "release-base"]
    },
    {
      "name": "native-relwithdebinfo",
      "displayName": "Native / RelWithDebInfo",
      "description": "Requires: conan install . -pr:a profiles/native -s build_type=RelWithDebInfo --build=missing",
      "inherits": ["base", "relwithdebinfo-base"]
    },
    {
      "name": "native-minsizerel",
      "displayName": "Native / MinSizeRel",
      "description": "Requires: conan install . -pr:a profiles/native -s build_type=MinSizeRel --build=missing",
      "inherits": ["base", "minsizerel-base"]
    },

    {
      "name": "x86_64-linux-gnu-debug",
      "displayName": "Cross / Debug / x86_64-linux-gnu",
      "description": "Cross to Linux x86_64 via x86_64-linux-gnu. Requires: conan install . -pr:b profiles/native -pr:h profiles/x86_64-linux-gnu -s build_type=Debug --build=missing",
      "inherits": "cross-base",
      "toolchainFile": "${sourceDir}/build/linux-x86_64-debug/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x86_64-linux-gnu-release",
      "displayName": "Cross / Release / x86_64-linux-gnu",
      "description": "Cross to Linux x86_64 via x86_64-linux-gnu. Requires: conan install . -pr:b profiles/native -pr:h profiles/x86_64-linux-gnu -s build_type=Release --build=missing",
